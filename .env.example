# ---- core ----
APP_ENV=development              # development | production
SECRET_KEY=change-me-with-a-long-random-string
DATABASE_URL=sqlite:///./data/app.db
STORAGE_DIR=./data/storage
LOG_DIR=./data/logs
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOW_REGISTRATION=true

# ---- first admin (created on startup if missing) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---- uploads / limits ----
MAX_UPLOAD_MB=500
MAX_ACTIVE_JOBS_PER_USER=2
ACCESS_TTL_MIN=30
REFRESH_TTL_DAYS=7

# ---- worker / reconstruction ----
WORKER_ENABLED=true
WORKER_CONCURRENCY=1             # keep 1 on a single GPU
JOB_TIMEOUT_SEC=7200
RUNNER=mock                      # mock | command
# command runner: placeholders {input} {output_dir}; env INPUT_VIDEO / OUTPUT_DIR are also set
RECON_COMMAND=jupyter nbconvert --to notebook --execute notebooks/reconstruct.ipynb --output-dir {output_dir} --ExecutePreprocessor.timeout=-1
